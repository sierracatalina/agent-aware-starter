{
  "version": "1.0",
  "priority_selectors": {
    "primary_action": "[data-agent-action='primary']",
    "navigation": "nav[role='navigation']"
  },
  "interaction_rules": {
    "max_retries": 3,
    "wait_for_selector_timeout": 5000,
    "ignore_elements": [
      ".ad-slot",
      ".user-generated-content"
    ]
  },
  "safety": {
    "prohibit_direct_input_to": [
      "#credit-card-field"
    ],
    "require_human_confirmation_for": [
      "/api/delete",
      "/api/transfer"
    ]
  }
}
