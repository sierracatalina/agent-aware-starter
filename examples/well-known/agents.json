{
  "schema_version": "0.1.1",
  "status": "example",
  "live": false,
  "http_action_api": "declared",
  "agent_card": {
    "name": "Example-Site-Orchestrator",
    "capabilities": [
      "data-retrieval",
      "form-automation"
    ],
    "endpoints": {
      "discovery": "/.well-known/ai-instructions.json",
      "action_root": "/api/v1/agent-actions"
    }
  },
  "endpoints": [
    {
      "name": "get_status",
      "description": "Returns service health.",
      "path": "/api/v1/agent-actions/status",
      "method": "GET",
      "risk_level": "low"
    },
    {
      "name": "submit_task",
      "description": "Queues an asynchronous task.",
      "path": "/api/v1/agent-actions/task",
      "method": "POST",
      "risk_level": "medium",
      "parameters": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          }
        },
        "required": [
          "description"
        ]
      }
    }
  ]
}
