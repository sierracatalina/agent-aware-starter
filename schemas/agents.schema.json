{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aaa:schema:agents:0.1.1",
  "title": "AAA agents.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "live",
    "http_action_api",
    "agent_card"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.1"
    },
    "status": {
      "enum": ["example", "draft", "active", "deprecated"]
    },
    "live": {
      "type": "boolean"
    },
    "http_action_api": {
      "enum": ["none", "declared"]
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "service_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "agent_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "capabilities", "endpoints"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "capabilities": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9.-]{0,99}$"
          }
        },
        "endpoints": {
          "type": "object",
          "additionalProperties": false,
          "required": ["discovery", "action_root"],
          "properties": {
            "discovery": {
              "$ref": "#/$defs/pathOrHttpsUrl"
            },
            "context": {
              "$ref": "#/$defs/pathOrHttpsUrl"
            },
            "action_root": {
              "anyOf": [
                { "const": "none" },
                { "$ref": "#/$defs/pathOrHttpsUrl" }
              ]
            }
          }
        }
      }
    },
    "endpoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/action"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "agent_card": {
            "properties": {
              "endpoints": {
                "properties": {
                  "action_root": { "const": "none" }
                },
                "required": ["action_root"]
              }
            },
            "required": ["endpoints"]
          }
        }
      },
      "then": {
        "properties": {
          "http_action_api": { "const": "none" }
        },
        "not": { "required": ["endpoints"] }
      },
      "else": {
        "properties": {
          "http_action_api": { "const": "declared" }
        },
        "required": ["endpoints"]
      }
    }
  ],
  "$defs": {
    "pathOrHttpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "anyOf": [
        { "pattern": "^/(?!/)(?!.*\\.\\.)(?!.*#)[^\\s]*$" },
        { "pattern": "^https://(?![^/]*@)[^\\s#]+$" }
      ]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "path", "method", "risk_level"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{0,99}$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "path": {
          "$ref": "#/$defs/pathOrHttpsUrl"
        },
        "method": {
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
        },
        "risk_level": {
          "enum": ["low", "medium", "high"]
        },
        "parameters": {
          "type": "object"
        }
      }
    }
  }
}
