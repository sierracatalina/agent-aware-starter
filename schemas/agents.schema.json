{
  "$comment": "AAA/0.2 schema identity 0.2.0. Additive over AAA/0.1. Every declared object schema has additionalProperties:false; catch-all patternProperties preserve arbitrary extensions and parameters, and string-valued selector maps.",
  "$id": "https://protocol.aaa.example/schemas/0.2.0/agents.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_card": {
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "endpoints": {
          "additionalProperties": false,
          "properties": {
            "action_root": {
              "anyOf": [
                {
                  "const": "none",
                  "type": "string"
                },
                {
                  "minLength": 1,
                  "type": "string"
                }
              ],
              "$comment": "Was oneOf; 'none' matched both branches so the settings profile value required by spec 00 invariant 2 could never validate. anyOf keeps the intent."
            },
            "discovery": {
              "minLength": 1,
              "type": "string"
            },
            "extensions": {
              "type": "object",
              "patternProperties": {
                "^": {}
              },
              "additionalProperties": false
            }
          },
          "required": [
            "discovery",
            "action_root"
          ],
          "type": "object"
        },
        "extensions": {
          "type": "object",
          "patternProperties": {
            "^": {}
          },
          "additionalProperties": false
        },
        "name": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "name",
        "capabilities",
        "endpoints"
      ],
      "type": "object"
    },
    "endpoints": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string"
          },
          "extensions": {
            "type": "object",
            "patternProperties": {
              "^": {}
            },
            "additionalProperties": false
          },
          "method": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS"
            ],
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "patternProperties": {
              "^": {}
            },
            "additionalProperties": false
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "risk_level": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "type": "string"
          }
        },
        "required": [
          "name",
          "path",
          "method"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^": {}
      },
      "additionalProperties": false
    },
    "http_action_api": {
      "type": "string"
    },
    "live": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    },
    "schema_version": {
      "minLength": 1,
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "protocol": {
      "type": "string",
      "description": "Protocol declaration, conventionally AAA/0.1 or AAA/0.2. Informational; legacy protocol strings remain valid."
    },
    "last_updated": {
      "type": "string",
      "description": "Publisher-provided update marker; dates are recommended but not required."
    }
  },
  "required": [
    "schema_version",
    "agent_card"
  ],
  "title": "AAA agents.json",
  "type": "object"
}
