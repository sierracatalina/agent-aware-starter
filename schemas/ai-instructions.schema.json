{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.aaa.example/schemas/0.2.0/ai-instructions.schema.json",
  "title": "AAA ai-instructions.json",
  "$comment": "AAA/0.2 schema identity 0.2.0. Additive over AAA/0.1. Every declared object schema has additionalProperties:false; catch-all patternProperties preserve arbitrary extensions and parameters, and string-valued selector maps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "protocol": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "live": {
      "type": "boolean"
    },
    "last_updated": {
      "type": "string"
    },
    "http_action_api": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow_autonomous_execution": {
          "type": "boolean",
          "description": "Advisory only. AAA never grants authority (spec 00, invariant 1: handshake, not authority)."
        },
        "require_human_approval_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rate_limit": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "patternProperties": {
            "^": {}
          },
          "additionalProperties": false
        },
        "read_freely": {
          "type": "boolean",
          "description": "Advisory publisher hint for public reading only. Never grants access or overrides user, authentication, or safety policy."
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actions": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "extensions": {
          "type": "object",
          "patternProperties": {
            "^": {}
          },
          "additionalProperties": false
        },
        "full_text": {
          "type": "string",
          "description": "Path or URI reference to a full-text companion for reading. Not an action endpoint or authority source."
        },
        "markdown_twin": {
          "type": "string",
          "description": "Readable rule or pointer for finding a Markdown companion, such as appending .md to a published page URL. Descriptive only; cannot widen authority."
        }
      }
    },
    "priority_selectors": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^": {
          "type": "string"
        }
      }
    },
    "interaction_rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_retries": {
          "type": "integer",
          "minimum": 0
        },
        "wait_for_selector_timeout": {
          "type": "integer",
          "minimum": 0
        },
        "ignore_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "object",
          "patternProperties": {
            "^": {}
          },
          "additionalProperties": false
        },
        "deep_link_pattern": {
          "type": "string",
          "description": "Template for settings deep links, e.g. app://settings?id=<anchor>."
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prohibit_direct_input_to": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "require_human_confirmation_for": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "object",
          "patternProperties": {
            "^": {}
          },
          "additionalProperties": false
        }
      }
    },
    "settings_actions": {
      "type": "array",
      "description": "Documented settings-destination actions for the settings profile.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "href": {
            "type": "string"
          },
          "data_agent_action": {
            "type": "string"
          },
          "extensions": {
            "type": "object",
            "patternProperties": {
              "^": {}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "out_of_settings_actions": {
      "type": "array",
      "description": "Documented out-of-Settings actions with how-to strings and confirmation flags (spec 03). Descriptive metadata only; AAA never grants authority.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "how_to",
          "requires_human_confirmation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "how_to": {
            "type": "string",
            "minLength": 1
          },
          "requires_human_confirmation": {
            "type": "boolean"
          },
          "extensions": {
            "type": "object",
            "patternProperties": {
              "^": {}
            },
            "additionalProperties": false
          },
          "name": {
            "type": "string",
            "description": "Human-readable action name."
          },
          "service": {
            "type": "string",
            "description": "Human-readable service label."
          },
          "href": {
            "type": "string",
            "description": "Documented hand-off destination; a URI reference, not an executable action API.",
            "format": "uri-reference"
          },
          "price": {
            "type": "string",
            "description": "Display-only price and currency text. Verify final terms in the human-operated payment flow."
          },
          "duration": {
            "type": "string",
            "description": "Display-only duration text; not a scheduling or execution instruction."
          }
        }
      }
    },
    "settings_anchors": {
      "type": "array",
      "description": "Documented deep-link ids for settings-desktop. Agents MUST NOT invent anchors.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "title": {
            "type": "string"
          },
          "deep_link": {
            "type": "string",
            "pattern": "^app://settings\\?id=[a-z][a-z0-9-]*$"
          },
          "extensions": {
            "type": "object",
            "patternProperties": {
              "^": {}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "patternProperties": {
        "^": {}
      },
      "additionalProperties": false
    }
  }
}
