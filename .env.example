# Local safe-default profile. This file contains no usable credential.
# Load explicitly with: node --env-file=.env server.js

HOST=127.0.0.1
PORT=3000

# A non-loopback HOST is rejected unless this is exactly true.
# This acknowledges exposure; it does not provide authentication or TLS.
AAA_ALLOW_NETWORK_BIND=false

# Must match the externally visible origin. Use HTTPS in production.
AAA_PUBLIC_ORIGIN=http://127.0.0.1:3000

# Optional path to a reviewed alternate config file.
AGENT_AWARE_CONFIG=./config/agent-aware.json

# Development-only single-host receipt file.
AAA_RECEIPT_FILE=./var/receipts.jsonl

# Protected actions fail closed while this is empty.
# For a loopback-only fixture, use a unique token of at least 16 characters.
AAA_API_TOKEN=

# Development identity attached to the static bearer token and required as the
# exact local principal assumption by the unsigned development verifier.
AAA_CLIENT_PRINCIPAL=urn:aaa:client:local
AAA_CLIENT_INSTANCE=urn:aaa:client-instance:local

# Development-only verifier. Keep false in production.
# When true, the verifier only checks the issuer allowlist below; it does not
# authenticate a signature, audience, key, revocation, or approval.
AAA_ALLOW_UNSIGNED_BUNDLES=false
AAA_TRUSTED_BUNDLE_ISSUERS=

# Comma-separated exact additional browser origins. No wildcards.
AAA_ALLOWED_ORIGINS=
